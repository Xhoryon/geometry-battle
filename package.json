{
  "name": "geometry-battle",
  "version": "1.0.0",
  "description": "AI Vibecoding 函数图像比赛",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "ts-node src/operator/cli.ts",
    "operator": "ts-node src/operator/cli.ts",
    "test": "ts-node tests/run-all.ts",
    "test:fairness": "ts-node tests/timing-fairness.ts",
    "stress": "ts-node src/map-stress-test.ts",
    "judge": "ts-node src/operator/judge.ts",

    "app": "npm run build:web && ts-node src/server/main.ts",
    "app:dev": "ts-node src/server/main.ts --dev",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "e2e": "npm run build:web && playwright test --config web/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
